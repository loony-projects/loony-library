# Settings for docker-compose.yml. Copy to .env (gitignored) and edit.

# Postgres (the db container). The password is required.
POSTGRES_DB=loony_library
POSTGRES_USER=loony
POSTGRES_PASSWORD=change-me

# Host ports.
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Where browsers reach the API. Compiled into the frontend image - run
# `docker compose up -d --build` after changing it.
VITE_API_URL=http://localhost:4000
# Frontend origin(s) the API accepts, comma-separated.
CORS_ORIGIN=http://localhost:8080

# "production" marks the session cookie Secure: fine on localhost and
# behind HTTPS, but sign-in won't stick over plain http on another host.
NODE_ENV=production

# Sign-in via loony-auth - see backend/.env.example. Inside a container,
# localhost is the container itself: if loony-auth runs on this machine,
# use http://host.docker.internal:8450 (Docker Desktop) or the host's IP.
LOONY_AUTH_URL=http://localhost:8450
CLIENT_ID=
TENANT_ID=
SECRET_KEY=
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback
