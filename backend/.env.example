DATABASE_URL=postgres://sankar:sankar@localhost:5432/loony_library
PORT=4000
# Frontend origin(s), comma-separated: Vite dev server, `vite preview`, and
# the public site when this server serves the built frontend through a
# tunnel (e.g. https://books.lovegood.in).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Sign-in via loony-auth (OAuth 2.1 + OpenID Connect).
# CLIENT_ID / SECRET_KEY come from registering this app as an OAuth client in
# loony-auth (admin console -> Applications, or POST /admin/oauth/applications)
# with every redirect URI in OAUTH_REDIRECT_URI. TENANT_ID is the loony-auth
# organization id; only its members can sign in.
# Never commit the real SECRET_KEY: put real values in .env (gitignored).
# LOONY_AUTH_URL is loony-auth's public URL (its issuer), e.g.
# https://auth.lovegood.in; "Account security" sends the browser there.
LOONY_AUTH_URL=http://localhost:8450
CLIENT_ID=00000000-0000-0000-0000-000000000000
TENANT_ID=00000000-0000-0000-0000-000000000000
SECRET_KEY=change-me
# One callback per origin the library is reached on, comma-separated; a
# sign-in uses the one on its own origin, e.g.
# http://localhost:4000/api/auth/callback,https://books.lovegood.in/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback
