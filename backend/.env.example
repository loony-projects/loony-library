DATABASE_URL=postgres://sankar:sankar@localhost:5432/loony_library
PORT=4000
# Frontend origin(s), comma-separated: Vite dev server, `vite preview`, and
# the public site when this server serves the built frontend through a
# tunnel (e.g. https://books.lovegood.in).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Sign in with Loony (OAuth 2.1 + OpenID Connect, through loony-auth).
# AUTH_CLIENT_ID / AUTH_SECRET_KEY come from registering this app as an OAuth client in
# loony-auth's `loony` organization (admin console -> Applications, or POST
# /admin/oauth/applications) with every redirect URI in OAUTH_REDIRECT_URI.
# Never commit the real AUTH_SECRET_KEY: put real values in .env (gitignored).
# LOONY_AUTH_URL is loony-auth's public URL (its issuer), e.g.
# https://auth.lovegood.in; "Account security" sends the browser there.
LOONY_AUTH_URL=http://localhost:2001
AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH_SECRET_KEY=change-me
# One callback per origin the library is reached on, comma-separated; a
# sign-in uses the one on its own origin, e.g.
# http://localhost:4000/api/auth/callback,https://books.lovegood.in/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Where book images and covers are kept: disk (backend/data, the default) or
# s3 (a loony-s3 bucket; see docs/dev_setup.md, "Images in loony-s3"). The
# book loader reads these from here too. Never commit the real secret.
IMAGE_STORE=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_CLIENT_ID=
S3_CLIENT_SECRET=
