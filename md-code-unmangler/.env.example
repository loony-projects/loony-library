# Copy this file to cleaner/.env to set defaults instead of retyping flags.
# Precedence, highest first: CLI flag > real environment variable > this file > built-in default.
# Folders are absolute or relative to $HOME (~ and $HOME are expanded), wherever the command runs from.
# The output folder must not be the input folder or inside it.

# Same as --lang (rust, js, java, sql or py), used when no --lang, --clean or --format is given
# CLEANER_LANG=py

# Same as --path (input folder)
# CLEANER_PATH=.output/Rust/rustatomicsandlocks/markdown

# Same as --out (output folder)
# CLEANER_OUT=.output/Rust/rustatomicsandlocks/markdown-cleaned

# Same as --width (line width for formatted code)
# CLEANER_WIDTH=88

# Same as --profile (only used with --lang rust). One of: bold-keywords, bold-plain-comments, keyword-density
# CLEANER_PROFILE=bold-keywords
